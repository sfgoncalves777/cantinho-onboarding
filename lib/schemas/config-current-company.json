{
  "$id": "config-current-company",
  "type": "object",
  "required": [
    "name",
    "tenant",
    "dns",
    "gtm",
    "siteMode",
    "address",
    "contacts",
    "citiesAndDistricts"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "dns": {
      "type": "string",
      "minLength": 1,
      "pattern": "^www\\..+"
    },
    "gtm": {
      "type": "string",
      "minLength": 9,
      "maxLength": 20
    },
    "siteMode": {
      "type": "string",
      "enum": [
        "both",
        "sale",
        "rent"
      ]
    },
    "address": {
      "type": "object",
      "required": [
        "street",
        "number",
        "district",
        "city",
        "state"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "complement": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "number",
          "hasWhatsapp",
          "context"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "hasWhatsapp": {
            "type": "boolean"
          },
          "context": {
            "type": "string",
            "enum": [
              "sale",
              "rent",
              "both",
              "general"
            ]
          }
        }
      }
    },
    "citiesAndDistricts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "districts"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "districts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "creci": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "number"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          }
        }
      }
     }
  }
}